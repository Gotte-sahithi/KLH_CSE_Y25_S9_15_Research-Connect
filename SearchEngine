import java.io.*;

public class SearchEngine {

    private Paper[] papers;
    private int paperCount;

    public SearchEngine() {

        papers =
                new Paper[100];

        paperCount = 0;

        loadPapers();
    }


    // =========================================
    // LOAD PAPERS FROM papers.txt
    // =========================================

    private void loadPapers() {

        try {

            BufferedReader reader =
                    new BufferedReader(
                            new FileReader(
                                    "papers.txt"
                            )
                    );

            String line;

            while (
                    (line = reader.readLine())
                            != null
            ) {

                if (
                        line.trim().isEmpty()
                                ||
                        line.startsWith("#")
                ) {
                    continue;
                }

                String[] data =
                        line.split(
                                "\\|",
                                -1
                        );

                if (data.length >= 9) {

                    papers[paperCount] =
                            new Paper(
                                    data[0],
                                    data[1],
                                    data[2],
                                    data[3],
                                    data[4],
                                    data[5],
                                    data[6],
                                    data[7],
                                    Integer.parseInt(
                                            data[8]
                                    )
                            );

                    paperCount++;
                }
            }

            reader.close();

        } catch (Exception e) {

            System.out.println(
                    "Error loading papers.txt"
            );
        }
    }


    // =========================================
    // SEARCH DOMAIN
    // =========================================

    public void searchDomain(
            String domain) {

        System.out.println();
        System.out.println(
                "Searching domain: " +
                domain
        );

        FileManager.saveHistory(domain);

        boolean found = false;

        for (
                int i = 0;
                i < paperCount;
                i++
        ) {

            String title =
                    papers[i]
                            .getTitle()
                            .toLowerCase();

            String paperDomain =
                    papers[i]
                            .getDomain()
                            .toLowerCase();

            String abstractText =
                    papers[i]
                            .getAbstractText()
                            .toLowerCase();

            String query =
                    domain.toLowerCase();

            boolean match =
                    KMP.search(
                            title,
                            query
                    ) != -1
                            ||
                    KMP.search(
                            paperDomain,
                            query
                    ) != -1
                            ||
                    KMP.search(
                            abstractText,
                            query
                    ) != -1;

            if (match) {

                System.out.println();
                System.out.println(
                        "[" + (i + 1) + "]"
                );

                System.out.println(
                        papers[i]
                                .getTitle()
                );

                System.out.println(
                        "Authors: " +
                        papers[i]
                                .getAuthors()
                );

                System.out.println(
                        "Year: " +
                        papers[i]
                                .getYear()
                );

                found = true;
            }
        }

        if (!found) {

            System.out.println(
                    "No papers found."
            );
        }
    }


    // =========================================
    // VIEW PAPER
    // =========================================

    public void viewPaper(
            int number) {

        if (
                number < 1
                        ||
                number > paperCount
        ) {

            System.out.println(
                    "Invalid paper number."
            );

            return;
        }

        papers[number - 1]
                .display();
    }


    // =========================================
    // KMP TITLE SEARCH
    // =========================================

    public void kmpSearch(
            String keyword) {

        boolean found = false;

        for (
                int i = 0;
                i < paperCount;
                i++
        ) {

            int position =
                    KMP.search(
                            papers[i]
                                    .getTitle()
                                    .toLowerCase(),
                            keyword.toLowerCase()
                    );

            if (position != -1) {

                papers[i].display();

                found = true;
            }
        }

        if (!found) {

            System.out.println(
                    "No matching titles."
            );
        }
    }


    // =========================================
    // RABIN-KARP
    // =========================================

    public void rabinKarpSearch(
            String keyword) {

        boolean found = false;

        for (
                int i = 0;
                i < paperCount;
                i++
        ) {

            int position =
                    RabinKarp.search(
                            papers[i]
                                    .getTitle()
                                    .toLowerCase(),
                            keyword.toLowerCase()
                    );

            if (position != -1) {

                papers[i].display();

                found = true;
            }
        }

        if (!found) {

            System.out.println(
                    "No matching titles."
            );
        }
    }


    // =========================================
    // Z ALGORITHM
    // =========================================

    public void zSearch(
            String keyword) {

        boolean found = false;

        for (
                int i = 0;
                i < paperCount;
                i++
        ) {

            int position =
                    ZAlgorithm.search(
                            papers[i]
                                    .getTitle()
                                    .toLowerCase(),
                            keyword.toLowerCase()
                    );

            if (position != -1) {

                papers[i].display();

                found = true;
            }
        }

        if (!found) {

            System.out.println(
                    "No matching titles."
            );
        }
    }


    // =========================================
    // FUZZY SEARCH
    // =========================================

    public void fuzzySearch(
            String query) {

        int bestIndex = -1;

        int bestDistance =
                Integer.MAX_VALUE;

        for (
                int i = 0;
                i < paperCount;
                i++
        ) {

            int distance =
                    FuzzySearch.editDistance(
                            query.toLowerCase(),
                            papers[i]
                                    .getTitle()
                                    .toLowerCase()
                    );

            if (
                    distance
                            <
                    bestDistance
            ) {

                bestDistance =
                        distance;

                bestIndex = i;
            }
        }

        if (bestIndex != -1) {

            System.out.println();
            System.out.println(
                    "Closest paper found:"
            );

            System.out.println(
                    "Edit Distance: " +
                    bestDistance
            );

            papers[bestIndex]
                    .display();
        }
    }


    // =========================================
    // SAVE PAPER
    // =========================================

    public void savePaper(
            int number) {

        if (
                number < 1
                        ||
                number > paperCount
        ) {

            System.out.println(
                    "Invalid paper number."
            );

            return;
        }

        FileManager.savePaper(
                papers[number - 1]
        );
    }
}
